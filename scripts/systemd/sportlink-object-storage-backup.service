[Unit]
Description=Sport Link local S3-compatible object storage backup
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
TimeoutStartSec=6h
EnvironmentFile=-/etc/default/sportlink-backup
ExecStart=/usr/local/sbin/sportlink-object-storage-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
