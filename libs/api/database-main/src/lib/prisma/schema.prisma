generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ───────────────────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  phone        String? @unique
  passwordHash String  @map("password_hash")

  // Profile fields (M04.1, M02.1). Replaces old PersonalAccount.
  username   String    @unique
  firstName  String?   @map("first_name")
  lastName   String?   @map("last_name")
  middleName String?   @map("middle_name")
  avatarUrl  String?   @map("avatar_url")
  birthDate  DateTime? @map("birth_date")
  bio        String?

  status UserStatus @default(ACTIVE)

  // Consents and terms versioning (M01.1)
  termsVersion    String?   @map("terms_version")
  privacyVersion  String?   @map("privacy_version")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions      UserSession[]
  platformRoles UserPlatformRole[]
  memberships   Membership[]
  verifications Verification[]
  auditLogs     AuditLog[]         @relation("AuditActor")

  @@index([status, createdAt])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

model UserSession {
  id         String   @id @default(uuid())
  tokenHash  String   @map("token_hash")
  userAgent  String?  @map("user_agent")
  ip         String?
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

// ─── Platform staff roles (M02, §2) ─────────────────────────────────────

model UserPlatformRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role PlatformRole

  grantedById String?   @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")

  @@unique([userId, role])
  @@index([role, revokedAt])
  @@map("user_platform_roles")
}

enum PlatformRole {
  SUPER_ADMIN
  MODERATOR
  SUPPORT
  ARBITER
  LAWYER
  FINANCIAL_OPERATOR
  CONTENT_MANAGER
  FUND_REPRESENTATIVE
}

// ─── Organizations & team access (M02) ──────────────────────────────────

model Organization {
  id          String           @id @default(uuid())
  legalName   String           @map("legal_name")
  displayName String           @map("display_name")
  inn         String           @unique
  ogrn        String?
  kind        OrganizationKind

  // Snapshot of the last requisites check (M02.1). Requisites ≠ mandate.
  requisitesCheckedAt DateTime? @map("requisites_checked_at")
  requisitesSource    String?   @map("requisites_source")

  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@index([status, kind])
  @@map("organizations")
}

enum OrganizationKind {
  ADVERTISER
  AGENCY
  ATHLETE_ENTITY
  FOUNDATION
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id String @id @default(uuid())

  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role        MembershipRole
  // Fine-grained permissions on top of role, e.g. deal:sign, payout:approve.
  permissions String[]         @default([])
  status      MembershipStatus @default(PENDING)

  invitedById String?   @map("invited_by_id")
  invitedAt   DateTime? @map("invited_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, organizationId, role])
  @@index([organizationId, status])
  @@map("memberships")
}

enum MembershipRole {
  OWNER
  MARKETER
  APPROVER
  ACCOUNTANT
  SIGNER
  AGENT
  LEGAL_REPRESENTATIVE
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

// ─── Verification (M03) ─────────────────────────────────────────────────

model Verification {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   VerificationKind
  status VerificationStatus @default(NOT_STARTED)

  // Object keys in S3-compatible storage; metadata only in DB.
  evidenceKeys String[] @default([]) @map("evidence_keys")

  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reason       String?

  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, kind])
  @@index([status, expiresAt])
  @@map("verifications")
}

enum VerificationKind {
  ATHLETE
  AGE
  LEGAL_ENTITY
  SELF_EMPLOYED
  AGENT_MANDATE
  LEGAL_REPRESENTATIVE
  FUND
}

enum VerificationStatus {
  NOT_STARTED
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  EXPIRED
}

// ─── Audit (M23.3, §4 TZ) ───────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(uuid())
  action     String
  targetType String  @map("target_type")
  targetId   String  @map("target_id")
  details    Json?
  reason     String?

  actorId String? @map("actor_id")
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
