{
  "name": "maps-of-the-world",
  "version": "0.0.0",
  "scripts": {
    "start:web": "nx run web:serve --open",
    "start:api": "yarn db:main:deploy && nx serve api",
    "start:api-deps:docker": "docker compose --env-file .env -f docker/docker-compose.dev.yml up",
    "build:web": "nx build web",
    "build:api": "nx build api",
    "build:web:prod": "nx build web --prod",
    "build:api:prod": "nx run api:build",
    "deploy:api:prod:docker:cloudflare-r2": "docker compose -f docker/docker-compose.prod.yml up -d",
    "deploy:api:prod:docker:minio": "docker compose -f docker/docker-compose.prod.yml --profile minio up -d",
    "db:main:migrate": "nx run api-database-main:migrate --name",
    "db:main:deploy": "nx run api-database-main:deploy",
    "db:main:generate": "nx run api-database-main:generate",
    "db:main:seed": "nx run api-database-main:seed",
    "admin:create-super": "nx run api-database-main:create-super-admin",
    "db:main:push": "nx run api-database-main:push",
    "lint": "yarn lint:workspace && nx run-many --target=lint --all",
    "lint:workspace": "node tools/scripts/validate-project-naming.mjs",
    "test": "nx run-many --target=test --all",
    "docs:gen": "rimraf documentation && compodoc -p .compodocrc.json",
    "docs:watch": "compodoc -p .compodocrc.json -s -w --open",
    "watch:all": "nx run-many --target=build --watch --projects=api,web --configuration=development",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.8",
